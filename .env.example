# Copy to .env.local for local development. Never commit your API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Set a private study access code before deploying. Share only with your testers.
APP_ACCESS_CODE=
# Optional stable random secret. Defaults to a key derived from OPENAI_API_KEY.
APP_SECRET=
PORT=3000
